<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkWindow" id="main_window">
    <property name="width_request">300</property>
    <property name="focusable">False</property>
    <property name="title" translatable="yes">Shutdown options</property>
    <property name="resizable">False</property>
    <property name="icon_name">system-shutdown</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">5</property>
        <property name="margin-start">10</property>
        <property name="margin-end">10</property>
        <property name="margin-top">10</property>
        <property name="margin-bottom">10</property>
        <child>
          <object class="GtkButton" id="btn_shutdown">
            <property name="label" translatable="yes">Shutdown</property>
            <property name="focusable">True</property>
            <property name="receives_default">True</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_reboot">
            <property name="label" translatable="yes">Reboot</property>
            <property name="focusable">True</property>
            <property name="receives_default">True</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_lock">
            <property name="label" translatable="yes">Lock Screen</property>
            <property name="focusable">True</property>
            <property name="receives_default">True</property>
            <property name="use_underline">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="btn_logout">
            <property name="label" translatable="yes" context="button">Logout</property>
            <property name="focusable">True</property>
            <property name="receives_default">True</property>
            <property name="use_underline">True</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
